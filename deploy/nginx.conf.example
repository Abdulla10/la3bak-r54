# TEMPLATE ONLY. It is not the official host configuration.
# Add trusted TLS certificates and an HTTPS listener before Internet exposure.
# Keep the application project outside any Nginx document root.
map $http_upgrade $la3bak_connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 127.0.0.1:8080;
    server_name YOUR_DOMAIN;
    client_max_body_size 16m;
    add_header Permissions-Policy 'camera=(), microphone=(self)' always;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $la3bak_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

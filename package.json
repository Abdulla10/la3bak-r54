{
  "name": "qawwi-aqlak",
  "version": "4.1.1-store.2",
  "description": "لعبك — منصة ألعاب عربية جماعية",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "smoke": "node scripts/smoke-real.mjs ${TMPDIR:-/tmp}/la3bak-smoke",
    "preflight": "node scripts/preflight.mjs tsx tsc",
    "predev": "node scripts/preflight.mjs tsx",
    "pretest": "node scripts/preflight.mjs tsx",
    "prebuild": "node scripts/preflight.mjs tsc",
    "pretypecheck": "node scripts/preflight.mjs tsc"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
